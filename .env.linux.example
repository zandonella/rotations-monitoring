# Linux production monitor (copy to .env.linux). The original .env / npm start
# continue to select the unmodified legacy Windows/Pi monitor.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
DISCORD_WEBHOOK_URL=
DISCORD_MENTION_ROLE_ID=
SITE_URL=https://rotations.lol
LINUX_POLL_INTERVAL_MINUTES=30
# Run status is read from Supabase's Linux-only linux_ingestion_status table.
DEGRADED_AFTER_MIN=5
ERROR_AFTER_MIN=20
HEARTBEAT_CHECK_INTERVAL_SEC=60
CHECK_INTERVAL_SEC=300
BACKUP_ENABLED=true
BACKUP_AT_UTC=01:00
BACKUP_RETENTION_DAYS=14
HOST=127.0.0.1
PORT=8080
